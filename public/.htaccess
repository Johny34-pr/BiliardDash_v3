# =============================================================================
# Magyar Biliárd Weboldal - Front Controller Apache konfiguráció
# =============================================================================
#
# Ez a fájl az alkalmazás web rootjában (public/) található. Két esetben
# érvényesül:
#   1. Ha az Apache DocumentRoot közvetlenül a public/ könyvtárra van állítva
#   2. Ha a gyökér szintű .htaccess ide irányítja a kérést
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---------------------------------------------------------------------
    # Front controller: minden nem létező fájl/könyvtár kérése az
    # index.php-hez kerül. A QSA megőrzi a query stringet, az L leállítja
    # a további szabályok feldolgozását.
    # ---------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# =============================================================================
# Alapértelmezett dokumentum és könyvtárlistázás tiltása
# =============================================================================
DirectoryIndex index.php
Options -Indexes

# =============================================================================
# Rejtett fájlok (pl. .env, .git) elérésének tiltása
# =============================================================================
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# =============================================================================
# Megjegyzés: a feltöltött fájlok védelme (PHP futtatás tiltása) a
# public/uploads/.htaccess fájlban van megvalósítva, mert a <Directory>
# direktíva .htaccess kontextusban nem használható.
# =============================================================================

# =============================================================================
# Alapvető biztonsági HTTP fejlécek
# =============================================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# =============================================================================
# Statikus erőforrások gyorsítótárazása (főoldal betöltési idő optimalizálás)
# =============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# =============================================================================
# Karakterkódolás és MIME típusok
# =============================================================================
<IfModule mod_mime.c>
    AddDefaultCharset UTF-8

    # A webmanifest és az SVG ikon helyes MIME típusa. Nélkülük a böngésző
    # figyelmeztetést ad, illetve nem ismeri fel a fájlt.
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
</IfModule>
