# =============================================================================
# Okányi Biliárd Klub weboldal - Front Controller Apache konfiguráció
# =============================================================================
#
# Ez a fájl az alkalmazás web rootjában (public/) található. Két esetben
# érvényesül:
#   1. Ha az Apache DocumentRoot közvetlenül a public/ könyvtárra van állítva
#   2. Ha a gyökér szintű .htaccess ide irányítja a kérést
# =============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # ---------------------------------------------------------------------
    # Front controller: minden nem létező fájl/könyvtár kérése az
    # index.php-hez kerül. A QSA megőrzi a query stringet, az L leállítja
    # a további szabályok feldolgozását.
    # ---------------------------------------------------------------------
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# =============================================================================
# Alapértelmezett dokumentum és könyvtárlistázás tiltása
# =============================================================================
DirectoryIndex index.php
Options -Indexes

# =============================================================================
# Rejtett fájlok (pl. .env, .git) elérésének tiltása
# =============================================================================
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# =============================================================================
# Megjegyzés: a feltöltött fájlok védelme (PHP futtatás tiltása) a
# public/uploads/.htaccess fájlban van megvalósítva, mert a <Directory>
# direktíva .htaccess kontextusban nem használható.
# =============================================================================

# =============================================================================
# Alapvető biztonsági HTTP fejlécek
# =============================================================================
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# =============================================================================
# Statikus erőforrások gyorsítótárazása
# =============================================================================
# A stíluslapok és szkriptek hivatkozásai ?v=<módosítási idő> verziót kapnak
# (lásd az asset() helpert), ezért hosszú lejárat is biztonságos: módosítás
# után a cím megváltozik, és a böngésző újra letölti a fájlt.
<IfModule mod_expires.c>
    ExpiresActive On

    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"

    # A webmanifest ritkán változik, de nem érdemes évre fagyasztani
    ExpiresByType application/manifest+json "access plus 1 week"

    # A HTML mindig friss kell: ebben jelenik meg az új tartalom
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# A verziózott erőforrások tartalma egy adott címen soha nem változik,
# ezért a böngésző újraellenőrzés nélkül is használhatja őket.
#
# Ez a szakasz a mod_headers modult igényli, amely XAMPP alatt alapból
# be van kapcsolva - így a gyorsítótárazás a mod_expires nélkül is
# érvényesül (a Cache-Control erősebb is annál).
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2?|jpe?g|png|webp|svg|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # A dinamikus válaszokat nem szabad gyorsítótárazni: bejelentkezett
    # állapotot és flash üzeneteket is tartalmazhatnak.
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# =============================================================================
# Tömörítés
# =============================================================================
# FIGYELEM: ez a szakasz csak akkor hatásos, ha a kiszolgálón be van
# kapcsolva a mod_deflate és a mod_filter. Az <IfModule> feltétel miatt
# hiányuk nem okoz hibát, viszont a válaszok tömörítés nélkül mennek ki.
#
# XAMPP alatt ezek alapból ki vannak kommentezve. Bekapcsolás az
# apache/conf/httpd.conf fájlban, majd Apache újraindítás:
#
#     LoadModule deflate_module modules/mod_deflate.so
#     LoadModule filter_module modules/mod_filter.so
#
# Ellenőrzés: a válasz fejlécében szerepelnie kell a
# "Content-Encoding: gzip" sornak. A szöveges erőforrások (HTML, CSS, JS)
# mérete így körülbelül a negyedére csökken.
#
# A képek és a woff2 már tömörített formátumok, ezért kimaradnak: újra
# tömörítve csak processzoridőt fogyasztanának méretcsökkenés nélkül.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
    AddOutputFilterByType DEFLATE application/javascript text/javascript
    AddOutputFilterByType DEFLATE application/json application/xml
    AddOutputFilterByType DEFLATE application/manifest+json
    AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# =============================================================================
# Karakterkódolás és MIME típusok
# =============================================================================
<IfModule mod_mime.c>
    AddDefaultCharset UTF-8

    # A webmanifest és az SVG ikon helyes MIME típusa. Nélkülük a böngésző
    # figyelmeztetést ad, illetve nem ismeri fel a fájlt.
    AddType application/manifest+json .webmanifest
    AddType image/svg+xml .svg
</IfModule>
