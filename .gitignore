# ==========================================================================
# Környezeti beállítások és titkos adatok
# ==========================================================================
# A .env adatbázis- és SMTP-hozzáféréseket, valamint az admin jelszót
# tartalmazza, ezért soha nem kerülhet verziókövetésbe.
# A .env.example minta marad, kitöltött értékek nélkül.
.env
.env.local
.env.*.local

# ==========================================================================
# Composer függőségek
# ==========================================================================
# A vendor/ könyvtár a composer.lock alapján bármikor újraépíthető
# a "composer install" paranccsal.
/vendor/
composer.phar

# ==========================================================================
# Stíluslap
# ==========================================================================
# A public/assets/css/tailwind.css generált fájl, mégis verziókövetett:
# így az oldal build lépés nélkül is kiszolgálható. Előállítása:
# "php tools/build-css.php". A projekt nem használ Node-ot és npm-et,
# ezért itt nincs node_modules kizárás.

# ==========================================================================
# Tesztelés
# ==========================================================================
/.phpunit.cache/
.phpunit.result.cache
/coverage/
/build/

# ==========================================================================
# Felhasználó által feltöltött tartalom
# ==========================================================================
# A galéria képei és a szerkesztőbe feltöltött média futásidőben keletkezik,
# nem a projekt része. A könyvtárstruktúrát a .gitkeep fájlok tartják meg.
/public/uploads/albums/*
!/public/uploads/albums/.gitkeep
/public/uploads/media/*
!/public/uploads/media/.gitkeep

# ==========================================================================
# Naplófájlok
# ==========================================================================
*.log
/logs/

# ==========================================================================
# Adatbázis mentések
# ==========================================================================
# A database/migrations/ alatti .sql fájlok verziókövetettek, az ad hoc
# mentések viszont éles adatot tartalmazhatnak, ezért kimaradnak.
/*_backup_*.sql
/*.dump.sql

# ==========================================================================
# Operációs rendszer által generált fájlok
# ==========================================================================
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# ==========================================================================
# Szerkesztők és fejlesztői eszközök
# ==========================================================================
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
*.sublime-workspace
*.swp
*.swo
*~

# ==========================================================================
# Ideiglenes fájlok
# ==========================================================================
*.tmp
*.bak
*.orig
