# Adatbázis konfiguráció
DB_HOST=localhost
DB_NAME=billiard
DB_USERNAME=root
DB_PASSWORD=

# Alkalmazás konfiguráció
APP_NAME="Okányi Biliárd Klub"

# A weboldal nyilvános címe, záró perjel nélkül.
# FONTOS: éles környezetben a valódi domainre kell állítani. Ebből épül fel
# a canonical URL, a közösségi megosztás (Open Graph) URL-je, valamint a
# sitemap.xml és a robots.txt tartalma. Ha localhost marad, a keresők és a
# Facebook is localhost címeket kapnának.
APP_URL=http://localhost
APP_DEBUG=false
ADMIN_PASSWORD=admin123

# Szerkesztő (TinyMCE) CDN kulcs
# Igényelhető a tiny.cloud oldalon. Üresen hagyva a szerkesztő működik,
# de figyelmeztetést jelenít meg.
TINYMCE_API_KEY=dg1pun9r315oclucr8p9k2vbr2diads6ekliyw49ihzw0450

# ==========================================================================
# E-mail küldés
# ==========================================================================
# MAIL_TRANSPORT - hogyan menjen ki a levél:
#
#   smtp  Külső SMTP kiszolgáló. Éles üzemhez ez kell, és MAIL_USERNAME +
#         MAIL_PASSWORD nélkül NEM működik (a kiszolgáló 535-tel elutasítja).
#   mail  A kiszolgáló helyi levelezője a PHP mail() függvényén keresztül.
#         Sok szolgáltatónál SMTP azonosítók nélkül is működik; XAMPP alatt
#         Windowson általában NEM, mert nincs helyi levelező.
#   log   Nem küld levelet, hanem a storage/logs/mail.log fájlba írja.
#         Fejlesztéshez, hogy az értesítések útja SMTP nélkül is
#         végigjárható és ellenőrizhető legyen.
MAIL_TRANSPORT=smtp

MAIL_HOST=smtp.example.com
MAIL_PORT=587

# Hitelesítés. Ha mindkettő üres, a rendszer hitelesítés NÉLKÜL kapcsolódik
# (helyi MailHog/Mailpit, vagy IP alapján engedélyező továbbító). Csak az
# egyiket megadni hiba: a kiszolgáló minden esetben elutasítja.
MAIL_USERNAME=
MAIL_PASSWORD=

# 587 -> tls, 465 -> ssl. Titkosítás nélkül: none (vagy hagyd üresen).
MAIL_ENCRYPTION=tls

# A feladó cím legyen valódi tartományú. A @localhost végű címet a
# PHPMailer és a levelezők is érvénytelenként elutasítják.
MAIL_FROM_ADDRESS=info@okanyibiliard.hu
MAIL_FROM_NAME="Okányi Biliárd Klub"
